{
  "name": "branilist-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multilingual Discord companion for Branilist, with a self-hosted website and dashboard.",
  "license": "MIT",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/dev.mjs --demo",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "commands:register": "tsx server/register.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "npm test && npm run build",
    "test:production": "node --test tests/production.smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aniyan-project/branilist-api": "0.1.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fontsource-variable/manrope": "5.3.0",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.7",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aniyan-Project/Discord-bot.git"
  },
  "bugs": {
    "url": "https://github.com/Aniyan-Project/Discord-bot/issues"
  },
  "homepage": "https://github.com/Aniyan-Project/Discord-bot#readme"
}
