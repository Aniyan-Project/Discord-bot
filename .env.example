NODE_ENV=development
PORT=4100
HOST=127.0.0.1
# Comma-separated trusted reverse proxy IPs/CIDRs. Empty means no proxy trust.
TRUST_PROXY=
APP_URL=http://localhost:5173
DATABASE_PATH=./data/branilist-bot.sqlite
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional guild for slash command development. Omit to register globally.
DISCORD_DEV_GUILD_ID=
# Prefix commands need Message Content Intent enabled in the Developer Portal.
ENABLE_MESSAGE_CONTENT=true
DEFAULT_PREFIX=b!
DEFAULT_LOCALE=pt-BR
# Server-side API key with catalog:read and search:read; never put it in VITE_*.
BRANILIST_API_KEY=
BRANILIST_CLIENT_ID=
BRANILIST_CLIENT_SECRET=
BRANILIST_GRAPHQL_URL=https://branilist.com/api/graphql
# Must match a registered redirect URI: APP_URL/auth/branilist/callback
BRANILIST_ISSUER=https://branilist.com
SUPPORT_URL=https://github.com/Aniyan-Project/Discord-bot/issues
DEMO_MODE=false
