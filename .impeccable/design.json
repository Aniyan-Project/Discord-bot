  "narrative": {
    "northStar": "Anime club at night",
    "overview": "An anime club at night: warm graphite panels, quiet neutral lettering and restrained orange actions frame real anime cover art. The workspace feels calm and useful; server administration and personal account authorization have separate destinations.\n\nThe shipped interface uses thin seams and tonal layers rather than decorative dashboard effects. Cover art supplies visual richness, while labels, state messages and a working Discord response preview explain what controls do.",
    "keyCharacteristics": [
      "Warm graphite layers with restrained orange actions.",
      "Self-hosted Manrope and compact, explicit labels.",
      "Original-host catalog covers with resilient initial fallbacks.",
      "Live draft preview and an explicit pending-save state."
    ],
    "rules": [
      {
        "name": "The Action Orange Rule",
        "body": "Use orange for primary actions, focus, selected switches and command links; keep large workspace surfaces graphite.",
        "section": "colors"
      },
      {
        "name": "The Quiet Panel Rule",
        "body": "Separate working areas with tonal changes and thin seams; reserve diffuse shadows for the public demonstration and dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the pending save bar and preview synchronized with the draft.",
      "Do preserve visible labels, focus outlines, native dialog behavior and reduced-motion support.",
      "Do retain original catalog cover hosts and the image fallback.",
      "Do use actual data or clearly labelled demo examples."
    ],
